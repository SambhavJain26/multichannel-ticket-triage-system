# Local n8n/Postgres runtime
# Copy to .env for local use. Never commit .env.

N8N_IMAGE=n8nio/n8n@sha256:9cb60554716a0ab11a966e79ed65171e1bbf00b6d262ba12aa119bba22eb6000
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_32_char_local_key_only
GENERIC_TIMEZONE=America/New_York

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PORT=5432
POSTGRES_DB=maintenance_triage
POSTGRES_USER=maintenance_triage
POSTGRES_PASSWORD=replace_with_local_postgres_password

# Local mail simulator. These are local-only demo credentials.
GREENMAIL_IMAGE=greenmail/standalone:2.1.10
GREENMAIL_USER=maintenance@example.test
GREENMAIL_PASSWORD=greenmail-local-password
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
GREENMAIL_HTTP_PORT=8080

# OpenAI API for Stage 3 harness. Keep real keys only in local .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STAGE3_MODEL=gpt-5-nano
STAGE3_FALLBACK_MODEL=gpt-5.6-luna
STAGE3_RUNS=3
